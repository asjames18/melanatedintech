# Copy to .dev.vars for Wrangler preview or .env for Vite-style local tooling.
# Never commit real secret values.
#
# Every variable below is read somewhere in src/ or scripts/. If you add one
# here, wire it up; if you remove a reader, remove it here too.

# --- Supabase -------------------------------------------------------------
# src/integrations/supabase/env.ts accepts several aliases for each of these and
# takes the first one that is set. SUPABASE_* is the canonical form.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_key
# High-entropy private secret shared only by Supabase pg_cron and the Website Launch nurture processor route.
NURTURE_PROCESSOR_SECRET=
# High-entropy private secret shared only by Supabase pg_cron and the transactional-email queue processor route.
EMAIL_QUEUE_PROCESSOR_SECRET=
# High-entropy private secret shared only by Supabase pg_cron and the AI Radar ingest route.
RADAR_INGEST_SECRET=
# Aliases honored by env.ts and by scripts/ (generate-og, audit-internal-links).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# --- Payments (Stripe) ----------------------------------------------------
# The prefix on this token selects the environment for the whole app:
# pk_test_ -> sandbox, pk_live_ -> live.
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_or_pk_live_key
STRIPE_SANDBOX_SECRET_KEY=sk_test_key
STRIPE_LIVE_SECRET_KEY=sk_live_key
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_test_secret
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_live_secret
# Optional. When set, Stripe calls are proxied through the Lovable connector
# gateway instead of going direct (src/lib/stripe.server.ts).
LOVABLE_API_KEY=

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=re_key
RESEND_FROM_EMAIL="Melanated In Tech <hello@melanatedintech.com>"
# Comma-separated recipients for contact, lead, and invoice admin notifications.
ADMIN_EMAILS=founder@example.com
# A real business mailing address, required before Website Launch marketing follow-up can be activated.
MARKETING_POSTAL_ADDRESS=

# --- AI providers ---------------------------------------------------------
# src/routes/api/public/agents/chat.ts resolves keys in the order
# <PROVIDER>_LIVE_API_KEY -> <PROVIDER>_SANDBOX_API_KEY -> <PROVIDER>_API_KEY,
# and also probes a VITE_-prefixed variant of each name.
OPENROUTER_API_KEY=
OPENROUTER_LIVE_API_KEY=
OPENROUTER_SANDBOX_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_LIVE_API_KEY=
ANTHROPIC_SANDBOX_API_KEY=
OPENAI_API_KEY=
OPENAI_LIVE_API_KEY=
OPENAI_SANDBOX_API_KEY=

# --- Content agent --------------------------------------------------------
# Daily generation cap and model for the admin content review queue
# (src/lib/content-agent.functions.ts).
CONTENT_AGENT_DAILY_LIMIT=
CONTENT_AGENT_MODEL=

# --- Admin bootstrap ------------------------------------------------------
# Must be exactly "true" for claimFirstAdmin to work, and it only succeeds while
# zero admins exist. Leave unset in normal operation.
ALLOW_ADMIN_BOOTSTRAP=
